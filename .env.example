# LLM Configuration
# Options: groq, openai, google
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# API Keys (Provide at least one according to LLM_PROVIDER)
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Embedding Configuration
# Options: local (sentence-transformers/all-MiniLM-L6-v2) or openai (text-embedding-3-small)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage Configuration
CHROMA_PERSIST_DIR=./data/chroma_db
FEEDBACK_FILE_PATH=./data/feedback.json

# Retrieval & Workflow Limits
TOP_K=4
MAX_RETRIES=2
